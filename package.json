{
  "name": "smarthr-patterns",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "run-s storybook",
    "storybook": "storybook dev -p 8008",
    "build-storybook": "NODE_OPTIONS=--openssl-legacy-provider storybook build",
    "lint": "run-p lint:*",
    "lint:js": "eslint './**/*.ts{,x}'",
    "lint:css": "echo \"後でちゃんとして! stylelint './**/*.ts{,x}'\"",
    "format": "run-p format:*",
    "format:js": "run-s 'lint:js --fix'",
    "format:css": "echo \"後でちゃんとして! runs-s 'lint:css --fix\""
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-intl": "^10.2.2",
    "react-is": "^19.3.1",
    "smarthr-normalize-css": "^1.1.0",
    "smarthr-ui": "^99.9.0",
    "styled-components": "^5.3.11"
  },
  "devDependencies": {
    "@storybook/addon-actions": "^8.6.19",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.19",
    "@storybook/addon-styling": "^1.3.7",
    "@storybook/react": "^8.6.19",
    "@storybook/react-vite": "^8.6.19",
    "@storybook/testing-library": "^0.2.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/styled-components": "^5.1.36",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-smarthr": "^14.13.0",
    "eslint-plugin-storybook": "^0.12.0",
    "npm-run-all": "^4.1.5",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.9.10",
    "prettier-config-smarthr": "^1.0.1",
    "storybook": "^8.6.19",
    "stylelint-config-smarthr": "^3.0.2",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "resolutions": {
    "jackspeak": "4.2.3"
  }
}
